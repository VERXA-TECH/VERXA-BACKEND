{
    "compilerOptions": {
      "target": "ES2020",
        "module": "commonjs",
        "sourceMap": true,
        "outDir": "./dist",
        "strict": true,
        "lib": ["ES2022", "DOM"],
        "skipLibCheck": true,

        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": ["./node_modules/@types", "./src/types"]
    },
    "include": ["./src/**/*"],
    "files": [
        "./src/types/express.d.ts",
    ],
}

