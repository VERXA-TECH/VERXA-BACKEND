{
    "compilerOptions": {
      "target": "ES2020",
        "module": "commonjs",
        "sourceMap": true,
        "outDir": "./dist",
        "strict": true,
        "lib": ["ES2022", "DOM"],
        "skipLibCheck": true,

        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": ["./node_modules/@types", "./src/types"]
    },
    "include": ["./src/**/*"],
    "files": [
        "./src/types/express.d.ts",
    ],
    "exclude": [
        "src/config/knex.ts",
        "src/services/email/providers/ses.provider.ts",
        "src/utils/geo.util.ts",
        "src/utils/audit-context.ts",
        "src/utils/helpers/admin/transaction.helper.ts",
        "src/utils/helpers/approval.helper.ts",
        "src/utils/helpers/asset.helper.ts",
        "src/utils/helpers/document.helper.ts",
        "src/utils/helpers/export.helper.ts"
    ]
}

