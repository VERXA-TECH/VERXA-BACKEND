        "dev": "nodemon --config nodemon.json",
        "build": "tsc -p tsconfig.json",
        "start": "NODE_OPTIONS=--enable-source-maps node dist/index.js",
        "prod": "npm run build && npm run start",
        "lint": "eslint . --max-warnings 0",
