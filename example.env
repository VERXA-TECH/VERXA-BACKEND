# Application
NODE_ENV=development
PORT=5013
BASE_URL=http://localhost:5013
ADMIN_CLIENT_URL=http://localhost:3000
TIMEZONE=Africa/Lagos
TRUST_PROXY=1

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=jeroid
JWT_AUDIENCE=jeroid-pay-users

# Session Configuration
SESSION_DOMAIN=localhost
SESSION_SECRET=your-session-secret
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_MAX_AGE_MS=604800000

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nodeboilerplate
DB_USER=user
DB_PASSWORD=securepassword
DB_SSL=false
DATABASE_URL=postgres://user:securepassword@postgres:5432/nodeboilerplate

# Redis Configuration
REDIS_URL=redis://redis:6379

# Encryption Keys (AES-256-GCM)
# Generate 32-byte keys for these variables
ENCRYPTION_KEY=
MFA_ENC_KEY=
PII_ENC_KEY=
FINANCE_ENC_KEY=
MASTER_ENC_KEY=

# Cipher Rotation
CIPHER_ROTATION_MONTHS=6
CIPHER_ROTATION_CRON=0 2 1 * *
CIPHER_TYPES=MFA,PII,FINANCE

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5013/api/v1/auth/google/callback
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:5013/api/v1/auth/apple/callback

# Email Configuration
EMAIL_PROVIDER=smtp
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="Jeroid Pay Boilerplate"
ADMIN_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com

# SMTP Provider
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# SendGrid Provider
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=

# AWS SES Provider
AWS_SES_REGION=
AWS_SES_PROFILE=
AWS_SES_CONFIGURATION_SET=default

# AWS Infrastructure (S3/KMS/SES)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Storage Configuration
STORAGE_PROVIDER=s3
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_PROFILE=
AWS_CLOUDFRONT_DOMAIN=

# Audit Log Security
AUDIT_SIGNING_KEY=
AUDIT_IP_HASH_SALT=

# External Integrations
COINMARKETCAP_API_KEY=
FIXER_API_KEY=
CURRENCYAPI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=

# Socket Configuration
SOCKET_ALLOWED_ORIGINS=http://localhost:3000

# CORS Configuration
ALLOWED_CORS_ORIGINS=http://localhost:3000